[_local_ol8.9_baseos_latest]
name=local Oracle Linux 8 BaseOS
baseurl=http://IP REPOSITORY/repository/ole8.9_baseos/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-oracle
gpgcheck=1
enabled=1
module_hotfixes=true

[_local_ol8.9_appstream]
name=Oracle Linux 8 Application Stream
baseurl=http://IP REPOSITORY/repository/ole8.9_appstream/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-oracle
gpgcheck=1
enabled=1
module_hotfixes=true

[_local_zabbix]
name=local Oracle Linux 8 Zabbix
baseurl=http://IP REPOSITORY/repository/zabbix/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-oracle
gpgcheck=0
enabled=1
module_hotfixes=true

[_local_containerd]
name=Containerd
baseurl=http://IP REPOSITORY/repository/containerd/
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-oracle
gpgcheck=0
enabled=1
module_hotfixes=true
